---
import Header from "../components/Header.astro";
const { title = "", showFooter = true } = Astro.props || {};
---

<body id="top">
    <Header title={title} />
    <main>
        <slot />
    </main>
    {
        showFooter && (
            <footer>
                &copy; 2026 Tomasz Gospodarczyk | built with
                <a href="https://astro.build/" rel="noopener">
                    <img
                        class="astro-logo"
                        src="/assets/astro.svg"
                        alt="astro build"
                    />
                </a>
            </footer>
        )
    }
</body>
<style>
    footer {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: calc(var(--gap) * 0.5);
    }
    .astro-logo {
        height: 1rem;
    }
</style>
