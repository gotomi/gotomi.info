---
// Component Imports
import MusicApp from "../components/MusicApp.svelte";
import PhotoGallery from "../components/PhotoGallery.svelte";
import Layout from "../layouts/Layout.astro";
import { instagramPhotos, music } from "../lib/data";

const photos = instagramPhotos.slice(0, 7);
---

<Layout
  title="After — music and photos | gotomi.info"
  description="Selected tracks and photos by Tomasz Gospodarczyk."
  heading="Hello!"
  variant="variant2"
>
  <section class="music" id="music">
    <h2 class="section-title">My music</h2>
    <p class="chunk">
      From time to time I create music using DAW, software instruments, MIDI and computer keyboard
      and sometimes my voice. I will probably never consider any of my tracks finished, but you can
      enjoy the latest drafts if you like.
    </p>
    <MusicApp playlist={music} client:visible />
  </section>
  <section class="photos" id="photos">
    <h2 class="section-title">My photos</h2>
    <PhotoGallery photos={photos} client:visible />
  </section>
</Layout>
