---
// Component Imports

import PhotoSwipe from "../components/PhotoSwipe.svelte";
import Layout from "../layouts/Layout.astro";
import { galleries } from "../lib/data";
---

<Layout
  title="Marta — photo gallery | gotomi.info"
  description="Photo galleries by Tomasz Gospodarczyk."
  heading="Hello Marta!"
  lang="pl"
  variant="variant4"
  showFooter={false}
>
  <div class="galleries">
    <div class="gallery">
      <PhotoSwipe photos={galleries.marta.items} ratio="2/3" client:load />
    </div>
    <div class="gallery">
      <PhotoSwipe photos={galleries.gdynia.items} ratio="16/9" client:visible />
    </div>
    <div class="gallery">
      <PhotoSwipe photos={galleries.nadmorskie.items} ratio="16/9" client:visible />
    </div>
  </div>
</Layout>

<style>
  .galleries {
    scroll-snap-type: y proximity;
    height: 100vh;
    overflow-y: auto;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
  }
  .galleries::-webkit-scrollbar {
    display: none;
  }

  .galleries .gallery {
    scroll-snap-align: start;
    height: 100vh;
  }
</style>
