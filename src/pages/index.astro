---
// Component Imports

import ProjectGallery from "../components/ProjectGallery.svelte";
import MusicApp from "../components/MusicApp.svelte";
import PhotoGallery from "../components/PhotoGallery.svelte";
import Layout from "../layouts/Layout.astro";
import { homePhotos, music, projects } from "../lib/data";

const photos = homePhotos;
---

<Layout
  title="Tomasz Gospodarczyk — engineering manager, frontend engineer, photographer"
  description="Personal page of Tomasz Gospodarczyk — engineering manager, frontend engineer, web performance enthusiast, music creator and photographer."
  heading="Hi, I'm Tomasz"
  variant="variant0"
>
  <section class="intro skew">
    <div class="content">
      <img src="/assets/me.jpg" alt="me" width="120" height="120" />
      <p class="chunk">
        I am a engineering manager, front-end engineer and webperformance enthusiast, occasional
        music creator and photographer. If you want to contact me, you can easily find me on{" "}
        <a href="https://twitter.com/gotomi">Twitter</a>,
        <a href="https://github.com/gotomi">GitHub</a> or{" "}
        <a href="https://linkedin.com/in/gotomi">Linkedin</a>.
      </p>
    </div>
  </section>

  <section class="projects mask" id="">
    <div class="content">
      <h2 class="section-title">Projects</h2>
      <ProjectGallery projects={projects} />
    </div>
  </section>

  <section class="mask" id="photos">
    <div class="content">
      <h2 class="section-title">Photos</h2>
      <PhotoGallery photos={photos} showFeatured={true} client:visible />
    </div>
  </section>

  <section class="music mask" id="music">
    <div class="content">
      <h2 class="section-title">Music</h2>
      <p class="chunk">
        From time to time I create music using DAW, software instruments, MIDI and computer keyboard
        and sometimes my voice. I will probably never consider any of my tracks finished, but you
        can enjoy the latest drafts if you like.
      </p>
      <MusicApp playlist={music} client:visible />
    </div>
  </section>
</Layout>
<style>
  section {
    background: var(--copy-bg-color);
    padding: calc(2 * var(--gap));
    max-width: 1200px;
    margin: 0 auto calc(4 * var(--gap)) auto;
    border-radius: 0 0 16px 16px;
    > .content {
      position: relative;
      z-index: 2;
    }
  }

  .mask {
    position: relative;
  }

  .mask::after {
    content: "";
    position: absolute;
    top: 0;
    left: -1px;
    width: calc(100% + 2px);
    height: 127px;
    background: #ffbf00;
    mask-image: url("/assets/bg/wave.svg");
    mask-size: cover;
    mask-repeat: no-repeat;
    transform: translateY(-25%) scaleY(0.5);
    z-index: 1;
  }

  .intro {
    background: none;
    padding: 0;
    .content {
      display: flex;
      gap: var(--gap);
      max-width: 500px;
      background: var(--copy-bg-color);
      padding: calc(2 * var(--gap));
      border-radius: 0 0 16px 16px;
      margin: 0 calc(-1 * var(--gap));
    }
  }

  .music {
    display: grid;
    gap: var(--gap);
  }
</style>
