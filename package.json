{
  "name": "gotomi.info",
  "version": "3.5.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "check-and-build": "npm run check && tsc --noEmit && astro build",
    "svelte-check": "svelte-check",
    "data:gallery": "node scripts/generate-gallery.mjs",
    "data:gallery:all": "node scripts/generate-gallery.mjs --all",
    "data:instagram": "node scripts/fetch-instagram.mjs",
    "data:instagram:derivatives": "node scripts/generate-instagram.mjs",
    "data:photos": "node scripts/generate-photos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "astro": "^7.4.5",
    "exif-reader": "^2.0.3",
    "mathjs": "^15.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
